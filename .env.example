# Gemini API key -- https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash

# Shared secret required by every API request (also used by the web UI login)
JARVIS_AUTH_TOKEN=change-me-to-a-long-random-string

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8010

# Comma-separated roots Jarvis may search/read. Defaults to the user's home dir.
# JARVIS_ALLOWED_ROOTS=C:\Users\me\Projects,C:\Users\me\Documents

# --- Security policy ---
# Disable specific tools entirely:
# JARVIS_BLOCKED_TOOLS=close_application,run_safe_command
# Pre-approve CONFIRM_REQUIRED tools (skips the confirmation prompt):
# JARVIS_AUTO_APPROVE_TOOLS=run_tests
# Refuse anything that is not READ_ONLY (recommended when exposed remotely):
# JARVIS_READ_ONLY_MODE=false
