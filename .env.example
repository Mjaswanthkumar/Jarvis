# Gemini API key -- https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Shared secret required by every API request (also used by the web UI login)
JARVIS_AUTH_TOKEN=change-me-to-a-long-random-string

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8010

# Comma-separated roots Jarvis may search/read. Defaults to the user's home dir.
# JARVIS_ALLOWED_ROOTS=C:\Users\me\Projects,C:\Users\me\Documents

# --- Security policy ---
# Disable specific tools entirely:
# JARVIS_BLOCKED_TOOLS=close_application,run_safe_command
# Pre-approve CONFIRM_REQUIRED tools (skips the confirmation prompt):
# JARVIS_AUTO_APPROVE_TOOLS=run_tests
# Refuse anything that is not READ_ONLY (recommended when exposed remotely):
# JARVIS_READ_ONLY_MODE=false

# --- Voice over the network (optional) ---
# Browsers only allow microphone access on a secure origin, so voice input from
# a phone needs HTTPS. Generate a cert with mkcert, then point these at it.
# JARVIS_TLS_CERTFILE=C:\path\to\cert.pem
# JARVIS_TLS_KEYFILE=C:\path\to\key.pem
# How reading untrusted content (files, logs) affects later actions in a turn:
#   strict     - any untrusted content escalates LOW_RISK to CONFIRM_REQUIRED (default)
#   suspicious - only content that trips the injection detector escalates
#   off        - no escalation (not recommended)
# JARVIS_TAINT_MODE=strict

# Raise a native Windows notification when a watch fires, so alerts reach you
# with no browser open. Set to false to keep alerts inside the web UI only.
# JARVIS_DESKTOP_NOTIFICATIONS=true
