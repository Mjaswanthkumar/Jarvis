# Gemini API key -- https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.0-flash

# Shared secret required by every API request (also used by the web UI login)
JARVIS_AUTH_TOKEN=change-me-to-a-long-random-string

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8010

# Comma-separated roots Jarvis may search/read. Defaults to the user's home dir.
# JARVIS_ALLOWED_ROOTS=C:\Users\me\Projects,C:\Users\me\Documents
